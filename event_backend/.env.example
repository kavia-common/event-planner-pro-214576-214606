# Backend environment variables (example)
#
# IMPORTANT:
# - Do not commit real secrets in .env
# - The orchestrator will set real values in the container's .env

# SQLAlchemy URL form:
# Convert from event_database/db_connection.txt:
#   psql postgresql://appuser:dbuser123@localhost:5000/myapp
# to:
#   postgresql+psycopg://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=postgresql+psycopg://appuser:dbuser123@localhost:5000/myapp

# JWT signing secret (set to a long random string in real deployments)
JWT_SECRET=change-me

# Optional:
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# React dev server origin(s), comma-separated
CORS_ALLOW_ORIGINS=http://localhost:3000
