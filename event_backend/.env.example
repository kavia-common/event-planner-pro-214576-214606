# Backend environment variables (example)
#
# IMPORTANT:
# - Do not commit real secrets in .env
# - The orchestrator will set real values in the container's .env

# SQLAlchemy URL form:
# Convert from event_database/db_connection.txt:
#   psql postgresql://appuser:dbuser123@localhost:5001/myapp
# to:
#   postgresql+psycopg://appuser:dbuser123@localhost:5001/myapp
POSTGRES_URL=postgresql+psycopg://appuser:dbuser123@localhost:5001/myapp

# JWT signing secret (set to a long random string in real deployments)
JWT_SECRET=change-me

# Optional:
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# React dev server origin(s), comma-separated
# Include both local dev and the hosted preview origin.
CORS_ALLOW_ORIGINS=http://localhost:3000,https://vscode-internal-22662-qa.qa01.cloud.kavia.ai:3000
